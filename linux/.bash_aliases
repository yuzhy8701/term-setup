# export PATH=/usr/lib/adcs/symlinks:$PATH

alias android-env='/google/src/head/depot/google3/gaia/tools/android/android-env.sh'
alias blaze-run='/google/src/head/depot/google3/devtools/blaze/scripts/blaze-run.sh'
alias crd-restart='sudo systemctl restart chrome-remote-desktop@${USER}'
alias devsite2='/google/data/ro/projects/devsite/devsite2'
alias gemini='/google/bin/releases/gemini-cli/tools/gemini'
alias gmaven-publisher='/google/bin/releases/android-devtools/gmaven/publisher/gmaven-publisher'
alias sendgmr='/google/bin/releases/gws-sre/files/sendgmr/sendgmr'
alias xaze="/google/data/ro/teams/xaze/xaze"
alias crd-session="sudo switch-graphical-session crd"
alias local-session="sudo switch-graphical-session local"
alias safergcp="/google/bin/releases/safer-gcp/tools/safergcp"
alias l="ls -lah --color=auto"
alias ls="ls --color=auto"
alias ll="ls -lh --color=auto"
alias la="ls -lah"
alias lsa="ls -lah --color=auto"
